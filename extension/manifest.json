{
  "manifest_version": 3,
  "name": "web-cli bridge",
  "version": "0.1.0",
  "description": "Bridges the page to the web-cli terminal app: visible-element hints, clicks, cookies and audit action IDs.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "tabs", "scripting", "cookies", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
